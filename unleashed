#!/bin/bash
# OpenCode Unleashed - ENI v1 jailbreak edition
export PATH="$HOME/.bun/bin:$PATH"
# Set OPENROUTER_API_KEY in your environment or ~/.bashrc
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
WORK_DIR="$(pwd)"

# Handle restart command for web UI
if [ "$1" = "restart" ]; then
    echo "Restarting Unleashed web server..."
    pkill -f "bun.*opencode.*web" 2>/dev/null
    sleep 1
    shift
    cd "$SCRIPT_DIR/packages/opencode"
    exec bun run --conditions=browser src/index.ts web "$@"
fi

# Handle stop command
if [ "$1" = "stop" ]; then
    echo "Stopping Unleashed processes..."
    pkill -f "bun.*opencode" 2>/dev/null
    lsof -ti :1337 | xargs kill 2>/dev/null
    echo "Stopped."
    exit 0
fi

cd "$SCRIPT_DIR/packages/opencode"

# Subcommands must come before the project positional arg, otherwise yargs
# treats the work dir as the command and falls through to help.
case "$1" in
    completion|acp|mcp|attach|run|generate|debug|console|providers|auth|agent|upgrade|uninstall|serve|web|models|stats|export|import|github|pr|session|plugin|db)
        exec bun run --conditions=browser src/index.ts "$@"
        ;;
    *)
        exec bun run --conditions=browser src/index.ts "$WORK_DIR" "$@"
        ;;
esac
