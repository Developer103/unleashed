#!/bin/bash
# OpenCode Unleashed - ENI v1 jailbreak edition
export PATH="$HOME/.bun/bin:$PATH"
# Set OPENROUTER_API_KEY in your environment or ~/.bashrc
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Handle restart command for web UI
if [ "$1" = "restart" ]; then
    echo "Restarting Unleashed web server..."
    pkill -f "bun.*opencode.*web" 2>/dev/null
    sleep 1
    shift
    cd "$SCRIPT_DIR/packages/opencode"
    exec bun run --conditions=browser src/index.ts web "$@"
fi

# Handle stop command
if [ "$1" = "stop" ]; then
    echo "Stopping Unleashed processes..."
    pkill -f "bun.*opencode" 2>/dev/null
    lsof -ti :1337 | xargs kill 2>/dev/null
    echo "Stopped."
    exit 0
fi

cd "$SCRIPT_DIR/packages/opencode"
exec bun run --conditions=browser src/index.ts "$@"
